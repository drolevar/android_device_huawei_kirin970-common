# Adoptable Storage
ro.crypto.volume.options=aes-256-xts

# Bluetooth
bluetooth.device.class_of_device=90,2,12
bluetooth.profile.asha.central.enabled?=true
bluetooth.profile.a2dp.source.enabled?=true
bluetooth.profile.avrcp.target.enabled?=true
bluetooth.profile.bas.client.enabled?=true
bluetooth.profile.gatt.enabled?=true
bluetooth.profile.hfp.ag.enabled?=true
bluetooth.profile.hid.device.enabled?=true
bluetooth.profile.hid.host.enabled?=true
bluetooth.profile.map.server.enabled?=true
bluetooth.profile.opp.enabled?=true
bluetooth.profile.pan.nap.enabled?=true
bluetooth.profile.pan.panu.enabled?=true
bluetooth.profile.pbap.server.enabled?=true
bluetooth.profile.sap.server.enabled?=true
ro.bt.bdaddr_path=/data/vendor/bluedroid/macbt

# Graphics
debug.renderengine.backend=threaded
ro.opengles.version=196610
ro.hardware.egl=mali
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.running_without_sync_framework=true
debug.sf.use_phase_offsets_as_durations=1
debug.sf.late.sf.duration=27600000
debug.sf.late.app.duration=20000000
debug.sf.early.sf.duration=27600000
debug.sf.early.app.duration=20000000
debug.sf.earlyGl.sf.duration=27600000
debug.sf.earlyGl.app.duration=20000000
debug.sf.hwc.min.duration=17000000

# Huawei
ro.vendor.config.hw_music_lp=true
ro.vendor.config.music_lp_vol=true
ro.vendor.config.board_ipa=true
ro.vendor.config.perfgenius=true
ro.vendor.tui.service=true
persist.rog_feature=1

# Media
persist.kirin.media.offload.enable=true
persist.kirin.media.hires.enable=true
persist.kirin.media.lowlatency.enable=false
persist.kirin.media.usbvoice.enable=true
persist.kirin.media.usbvoice.name=USB-Audio - HUAWEI GLASS

# Netflix
ro.netflix.bsp_rev=KIRIN970-15244-1

# Platform
ro.kirin.product.platform=kirin970
ro.comp.chipset_version=Chipset-boston 102.0.0.001(1ISW)

# Power HAL
vendor.powerhal.disp.idle_support=false

# RIL
ro.telephony.default_network=9,9
persist.radio.dualltecap=1

# Sensors
use_sensorhub_labc=false

# Touch
persist.kirin.touch_vsync_opt=1
persist.vendor.touch_move_opt=1
persist.vendor.touchevent_opt=1

# VoLTE
ro.config.hw_volte_on=true
