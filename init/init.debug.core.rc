on post-fs && property:ro.debuggable=1
    start blanc_boot_diag

service blanc_boot_diag /system_ext/bin/blanc-boot-diag.sh
    user root
    group root system log readproc
    seclabel u:r:su:s0
    disabled
    oneshot

# Bring-up diagnostics: start USB adbd once all non-bootstrap APEXes are ready
# (including com.android.adbd) and /apex/com.android.adbd/etc/init.rc is parsed.
on property:apexd.status=ready && property:ro.debuggable=1
    setprop sys.usb.config adb
